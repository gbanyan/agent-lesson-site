---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { url } from '../lib/urls';
import { palette, paletteCss } from '../lib/palette';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/primitives.css';
import '../styles/diagrams.css';
import '../styles/lesson.css';

interface Props { title: string; description?: string; canonicalPath?: string; }
const { title, description = '用很小的概念，看懂 AI Agent 正在對你的電腦做什麼。', canonicalPath } = Astro.props;
const fullTitle = title === '看懂 Agent' ? title : `${title}｜看懂 Agent`;
const canonical = new URL(canonicalPath ? url(canonicalPath) : Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={palette.light.paper} />
    <title>{fullTitle}</title>
    <Fragment set:html={`<style>${paletteCss()}</style>`} />
    <script is:inline>
      // Theme state lives here so the page paints in the right theme before body renders.
      // window.siteTheme is shared with the toggle wiring at the end of <body>.
      (() => {
        const system = matchMedia('(prefers-color-scheme: dark)');
        // `chosen` keeps a click working for this page even when storage is blocked.
        let chosen = null;
        const saved = () => {
          if (chosen) return chosen;
          try {
            const value = localStorage.getItem('theme');
            return value === 'light' || value === 'dark' ? value : 'system';
          } catch (_) { return 'system'; }
        };
        const apply = () => {
          const choice = saved();
          const root = document.documentElement;
          if (choice === 'system') delete root.dataset.theme; else root.dataset.theme = choice;
          const paper = getComputedStyle(root).getPropertyValue('--paper').trim();
          if (paper) document.querySelector('meta[name="theme-color"]')?.setAttribute('content', paper);
          return { choice, actual: choice === 'system' ? (system.matches ? 'dark' : 'light') : choice };
        };
        const set = (choice) => {
          chosen = choice;
          try {
            if (choice === 'system') localStorage.removeItem('theme'); else localStorage.setItem('theme', choice);
          } catch (_) {}
          return apply();
        };
        window.siteTheme = { apply, set, system };
        apply();
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要內容</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <script is:inline>
      (() => {
        // Theme toggle: markup in Header.astro, state in window.siteTheme (see <head>).
        const button = document.querySelector('[data-theme-toggle]');
        const theme = window.siteTheme;
        if (button instanceof HTMLButtonElement && theme) {
          const choices = ['system', 'light', 'dark'];
          const labels = { system: '跟隨系統', light: '淺色', dark: '深色' };
          const paint = ({ choice, actual }) => {
            button.dataset.choice = choice;
            button.setAttribute('aria-label', `外觀：${labels[choice]}；目前為${labels[actual]}模式。按下可切換。`);
            const label = button.querySelector('[data-theme-label]');
            if (label) label.textContent = `外觀：${labels[choice]}`;
          };
          button.addEventListener('click', () => {
            const current = button.dataset.choice ?? 'system';
            paint(theme.set(choices[(choices.indexOf(current) + 1) % choices.length]));
          });
          theme.system.addEventListener('change', () => paint(theme.apply()));
          paint(theme.apply());
        }
      })();
      // Copy buttons: see CopyablePrompt.astro for the data-copy-* contract.
      document.addEventListener('click', async (event) => {
        const button = event.target instanceof Element ? event.target.closest('[data-copy-prompt]') : null;
        if (!(button instanceof HTMLButtonElement)) return;
        const root = button.closest('[data-copy-root]');
        const text = root?.querySelector('[data-copy-source]')?.textContent ?? '';
        const status = root?.querySelector('[data-copy-status]');
        try {
          if (!navigator.clipboard) throw new Error('clipboard unavailable');
          await navigator.clipboard.writeText(text);
          button.textContent = '已複製';
          if (status) status.textContent = '文字已複製到剪貼簿。';
          window.setTimeout(() => { button.textContent = button.dataset.copyLabel ?? '複製'; }, 1800);
        } catch {
          if (status) status.textContent = '無法自動複製，請選取文字後手動複製。';
        }
      });
    </script>
  </body>
</html>
