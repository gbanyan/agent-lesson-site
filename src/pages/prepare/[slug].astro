---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PromptShelf from '../../components/education/PromptShelf.astro';
import SystemMap from '../../components/education/SystemMap.astro';
import { url } from '../../lib/urls';
import { getContent, href } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getCollection('preflightGuides');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const guide = entry.data;
const { Content } = await render(entry);
const { previous, next } = (await getContent()).guideNeighbors(guide.id);
---
<BaseLayout title={guide.title} description={guide.summary}>
  <article class="reading article guide">
    <header class="page-header">
      <p class="eyebrow kicker">前置觀念</p>
      <h1>{guide.title}</h1>
      <p class="lede">{guide.summary}</p>
    </header>
    <aside class="guide-principle callout" data-tone="leaf"><strong>判斷原則：</strong>{guide.principle}</aside>
    <div class="wide"><SystemMap {...guide.visual} /></div>
    <div class="guide-body"><Content /></div>
    <PromptShelf prompts={guide.prompts} />
    <nav class="lesson-next" aria-label="前置說明前後導覽">
      <span>{previous && <a class="tap" href={href.guide(previous)}>← {previous.title}</a>}</span>
      <span>{next ? <a class="tap" href={href.guide(next)}>{next.title} →</a> : <a class="tap" href={url('/start/')}>選一個情境開始 →</a>}</span>
    </nav>
  </article>
</BaseLayout>

<style>
  .guide-body { margin-top: 2.5rem; color: var(--ink-soft); }
  .guide-body :global(p + p) { margin-top: 1.5rem; }
</style>
