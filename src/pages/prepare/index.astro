---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from '../../components/education/GuideCard.astro';
import { getContent } from '../../lib/content';
const content = await getContent();
---
<BaseLayout title="前置觀念" description="開始使用 Agent 前，先想清楚你能交出去什麼，並確認會隨產品變動的費用、安裝、選用與資料規則。">
  <header class="page-header shell">
    <p class="eyebrow kicker">前置觀念</p>
    <h1>開始用 Agent 前，該先想清楚哪些事？</h1>
    <p>先盤點你能把哪些事交給 Agent，再查清楚會隨產品改變的費用、安裝方式、產品差異與資料規則，這些請自己查目前的官方說明。不會變的判斷原則，放在課文區慢慢教。</p>
  </header>
  <section class="shell card-grid" aria-label="前置觀念說明">
    {content.guides.map((guide) => <GuideCard guide={guide} heading="h2" />)}
  </section>
</BaseLayout>
