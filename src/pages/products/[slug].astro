---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OfficialInfoNotice from '../../components/education/OfficialInfoNotice.astro';
import { getContent, href } from '../../lib/content';

export async function getStaticPaths() {
  const content = await getContent();
  return content.productBridges.map((bridge) => ({ params: { slug: bridge.slug }, props: { bridge } }));
}
const { bridge } = Astro.props;
const content = await getContent();
---
<BaseLayout title={bridge.product} description={bridge.intro}>
  <article class="reading page-header">
    <p class="eyebrow kicker">對照產品</p><h1>使用 {bridge.product} 前</h1><p class="lede">{bridge.intro}</p>
    <h2>相關基本觀念</h2>
    <ol class="path-steps">{bridge.concepts.map(content.lesson).map((lesson) => <li><div><a href={href.lesson(lesson)}>{lesson.question}</a></div></li>)}</ol>
    <p>實際安裝方式、支援平台、方案與功能可能隨時間改變。</p>
    <OfficialInfoNotice url={bridge.officialUrl} items={bridge.check} />
  </article>
</BaseLayout>
