---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SafetyGate from '../../components/education/SafetyGate.astro';
import FlowDiagram from '../../components/education/FlowDiagram.astro';
import { getContent, href } from '../../lib/content';

export async function getStaticPaths() {
  const content = await getContent();
  return content.paths.map((path) => ({ params: { slug: path.slug }, props: { path } }));
}
const { path } = Astro.props;
const content = await getContent();
const steps = content.pathSteps(path);
const optional = (path.optionalLessons ?? []).map(content.lesson);
const safetyItems = path.safetyGate?.map((item) => ({ href: href.lesson(content.lesson(item.lesson)), label: item.label }));
const exitGuide = path.exit && content.guide(path.exit.guide);
---
<BaseLayout title={path.title} description={path.description}>
  <article class="reading page-header">
    <p class="eyebrow kicker">情境路徑 · {steps.length} 個概念</p><h1>{path.title}</h1><p class="lede">{path.description}</p>
    {safetyItems && <SafetyGate items={safetyItems} />}
    {path.diagram && <FlowDiagram {...path.diagram} />}
    <ol class="path-steps">{steps.map((step) => <li><div><a href={href.pathStep(path, step.lesson)}>{step.title}</a><p class="muted">{step.intro}</p></div></li>)}</ol>
    {optional.length > 0 && <aside class="optional-step callout"><h2>需要時再看</h2>{optional.map((lesson) => <p><a href={href.lesson(lesson)}>{lesson.question}</a></p>)}</aside>}
    {path.exit && exitGuide && <aside class="path-exit panel" data-tone="leaf">
      <h2>{path.exit.title}</h2>
      <p>{path.exit.text}</p>
      <p><a href={href.guide(exitGuide)}>{exitGuide.title} →</a></p>
    </aside>}
  </article>
</BaseLayout>
<style>
  .optional-step, .path-exit { margin-top: 2rem; }
  .optional-step h2, .path-exit h2 { margin-top: 0; font-size: var(--step-1); }
  .path-exit p { margin: .5rem 0 0; }
  .path-exit a { font-weight: var(--weight-strong); }
</style>
