---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SafetyGate from '../../components/education/SafetyGate.astro';
import AgentCommandMap from '../../components/education/AgentCommandMap.astro';
import { url } from '../../lib/urls';
export async function getStaticPaths(){ const paths=await getCollection('paths'); return paths.map(entry=>({params:{slug:entry.data.slug},props:{entry}})); }
const { entry } = Astro.props;
const lessons = await getCollection('lessons');
const byId = new Map(lessons.map((lesson) => [lesson.data.id, lesson]));
const steps = entry.data.lessons.map((id:string) => byId.get(id)).filter(Boolean);
const optionalSteps = (entry.data.optionalLessons ?? []).map((id:string) => byId.get(id)).filter(Boolean);
const safetyItems = [
  {href:url('/lessons/working-scope/'),label:'Agent 正在哪個範圍工作'},
  {href:url('/lessons/read-vs-write/'),label:'這個動作會不會修改資料'},
  {href:url('/lessons/recovery-before-change/'),label:'如果結果不好，要從哪裡恢復'},
  {href:url('/lessons/beyond-files/'),label:'它是否可能影響外部系統'},
];
---
<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="reading page-header">
    <p class="eyebrow">情境路徑 · {steps.length} 個概念</p><h1>{entry.data.title}</h1><p class="lesson-answer">{entry.data.description}</p>
    {entry.data.safetyGate && <SafetyGate items={safetyItems} />}
    {entry.data.slug === 'agent-runs-command' && <AgentCommandMap />}
    <ol class="path-steps">{steps.map((lesson) => lesson && <li><div><a href={url(`/paths/${entry.data.slug}/${lesson.data.slug}/`)}>{lesson.data.question}</a><p class="muted">{lesson.data.answer}</p></div></li>)}</ol>
    {optionalSteps.length > 0 && <aside class="optional-step"><h2>需要時再看</h2>{optionalSteps.map((lesson) => lesson && <p><a href={url(`/lessons/${lesson.data.slug}/`)}>{lesson.data.question}</a></p>)}</aside>}
  </article>
</BaseLayout>
<style>.optional-step { margin-top:2rem; padding:1.25rem; border-left:4px solid var(--line); background:var(--surface-soft); }.optional-step h2 { margin-top:0; font-size:var(--step-1); }</style>
