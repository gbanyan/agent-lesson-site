---
import { getCollection } from 'astro:content';
import LessonPage from '../../../components/education/LessonPage.astro';
import { getContent } from '../../../lib/content';

// Each path step is a static page that keeps the lesson's canonical URL.
export async function getStaticPaths() {
  const [content, entries] = await Promise.all([getContent(), getCollection('lessons')]);
  const entryById = new Map(entries.map((entry) => [entry.data.id, entry]));
  return content.paths.flatMap((path) => content.pathSteps(path).map((pathStep) => ({
    params: { path: path.slug, lesson: pathStep.lesson.slug },
    props: { entry: entryById.get(pathStep.lesson.id)!, pathStep },
  })));
}
const { entry, pathStep } = Astro.props;
---
<LessonPage entry={entry} pathStep={pathStep} />
