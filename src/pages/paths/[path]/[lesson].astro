---
import { getCollection } from 'astro:content';
import LessonPage from '../../../components/education/LessonPage.astro';
import { url } from '../../../lib/urls';

export async function getStaticPaths() {
  const [paths, lessons] = await Promise.all([getCollection('paths'), getCollection('lessons')]);
  const byId = new Map(lessons.map((lesson) => [lesson.data.id, lesson]));
  return paths.flatMap((path) => path.data.lessons.flatMap((id, index) => {
    const entry = byId.get(id);
    if (!entry) return [];
    const previousLesson = index > 0 ? byId.get(path.data.lessons[index - 1]!) : undefined;
    const nextLesson = index < path.data.lessons.length - 1 ? byId.get(path.data.lessons[index + 1]!) : undefined;
    const wrapperHref = (slug:string) => url(`/paths/${path.data.slug}/${slug}/`);
    return [{
      params: { path:path.data.slug, lesson:entry.data.slug },
      props: {
        entry,
        pathContext: {
          slug:path.data.slug,
          title:path.data.title,
          step:index + 1,
          total:path.data.lessons.length,
          previous:previousLesson ? { href:wrapperHref(previousLesson.data.slug), label:previousLesson.data.question } : undefined,
          next:nextLesson ? { href:wrapperHref(nextLesson.data.slug), label:nextLesson.data.question } : undefined,
          returnHref:url(`/paths/${path.data.slug}/`),
        },
      },
    }];
  }));
}
const { entry, pathContext } = Astro.props;
---
<LessonPage entry={entry} pathContext={pathContext} />
