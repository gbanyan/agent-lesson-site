---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/urls';
const lessons = (await getCollection('lessons')).sort((a,b) => a.data.section.localeCompare(b.data.section) || a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="找概念">
  <header class="page-header shell"><p class="eyebrow">概念索引</p><h1>要查哪個概念？</h1><p>輸入一個詞，或從下方清單選擇。各頁都能獨立閱讀。</p></header>
  <section class="shell search-area" data-pagefind-ignore>
    <label for="search"><strong>搜尋概念</strong></label>
    <input id="search" type="search" inputmode="search" autocomplete="off" placeholder="例如：Git、Command、Backup" data-base={base} />
    <p id="search-status" class="muted" role="status" aria-live="polite"></p>
    <ol id="search-results" class="search-results"></ol>
  </section>
  <section class="shell concept-list" data-pagefind-ignore>
    <h2>全部概念</h2>
    <ul>{lessons.map((lesson) => <li><a href={url(`/lessons/${lesson.data.slug}/`)}>{lesson.data.question}</a></li>)}</ul>
  </section>
  <script is:inline>
    const input = document.querySelector('#search');
    const status = document.querySelector('#search-status');
    const list = document.querySelector('#search-results');
    let timer;
    async function search() {
      if (!input || !status || !list) return;
      const query = input.value.trim();
      list.replaceChildren();
      if (!query) { status.textContent = ''; return; }
      status.textContent = '搜尋中…';
      try {
        const base = input.dataset.base ?? '/';
        const pagefind = await import(/* @vite-ignore */ `${base}pagefind/pagefind.js`);
        const response = await pagefind.search(query);
        const items = await Promise.all(response.results.slice(0, 8).map((result) => result.data()));
        for (const item of items) {
          const li = document.createElement('li'); const a = document.createElement('a');
          a.href = item.url; a.textContent = item.meta.title ?? '查看結果';
          const p = document.createElement('p'); p.innerHTML = item.excerpt;
          li.append(a, p); list.append(li);
        }
        status.textContent = items.length ? `找到 ${items.length} 個結果` : '找不到相符概念。可以換一個更短的詞。';
      } catch { status.textContent = '搜尋功能目前還沒準備好，請從下方的完整清單選擇。'; }
    }
    input?.addEventListener('input', () => { window.clearTimeout(timer); timer = window.setTimeout(search, 180); });
  </script>
</BaseLayout>
<style>
  .search-area { padding-bottom: 2rem; }
  .search-area label { display:block; margin-bottom:.5rem; }
  .search-area input { width:min(100%,38rem); min-height:3.2rem; padding:.7rem 1rem; border:1px solid var(--line); border-radius:.8rem; background:var(--surface); color:var(--ink); }
  .search-results { width:min(100%,44rem); padding:0; list-style:none; }
  .search-results li { padding:1rem 0; border-bottom:1px solid var(--line); }
  .search-results a { font-weight:750; }
  .search-results p { margin:.3rem 0; color:var(--ink-soft); }
  .concept-list { padding-block:2rem 5rem; }
  .concept-list ul { padding:0; list-style:none; columns:2; column-gap:2rem; }
  .concept-list li { break-inside:avoid; padding:.55rem 0; }
  @media(max-width:44rem){.concept-list ul{columns:1}}
</style>
