---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TaskTimeline from '../../components/education/TaskTimeline.astro';
import { url } from '../../lib/urls';
import { getContent, href } from '../../lib/content';

export async function getStaticPaths() {
  const content = await getContent();
  return content.tasks.map((task) => ({ params: { slug: task.slug }, props: { task } }));
}
const { task } = Astro.props;
const content = await getContent();
const steps = task.steps.map((step) => ({
  actor: step.actor,
  kind: step.kind,
  text: step.text,
  refs: step.lessons.map(content.lesson).map((lesson) => ({ label: lesson.question, href: href.lesson(lesson) })),
}));
---
<BaseLayout title={`任務示例｜${task.title}`} description={task.situation}>
  <article class="reading page-header task-page" data-pagefind-body>
    <p class="eyebrow kicker">任務示例 · 說明用的例子，不需要跟著操作</p>
    <h1 data-pagefind-meta={`title=${task.title}`}>{task.title}</h1>
    <p class="lede">{task.situation}</p>
    <TaskTimeline steps={steps} />
    <aside class="task-outcome callout" data-tone="leaf"><strong>實際結果會像這樣</strong><p>{task.outcome}</p></aside>
    <aside class="task-boundary callout" data-tone="amber"><strong>邊界：</strong>{task.boundary}</aside>
    <p class="task-note note">不同產品的步驟與提示詞會不一樣。想先理解背後的觀念，可以從<a href={url('/start/')}>依情境開始</a>，或直接<a href={url('/concepts/')}>找概念</a>。</p>
  </article>
</BaseLayout>

<style>
  .task-page { padding-bottom: 4rem; }
  .task-outcome, .task-boundary, .task-note { margin-top: 1.5rem; }
  .task-outcome p { margin: .25rem 0 0; font-weight: var(--weight-strong); }
</style>
