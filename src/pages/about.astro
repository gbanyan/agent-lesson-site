---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutContent from '../content/introduction.md';
import { url } from '../lib/urls';
---
<BaseLayout title="關於本站">
  <article class="reading page-header about-page">
    <h1>關於本站</h1>
    <div class="introduction-body"><AboutContent /></div>
    <a class="button" href={url('/start/')}>選一個情境開始</a>
  </article>
</BaseLayout>

<style>
  .about-page{padding-bottom:4rem}
  .introduction-body{margin-block:2rem;font-size:var(--step-1);line-height:1.85}
  .introduction-body :global(> :first-child){margin-top:0}
  .introduction-body :global(h2){margin-top:3rem}
</style>
