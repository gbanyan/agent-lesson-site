---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContent, href } from '../lib/content';
const content = await getContent();
const ideationGuide = content.guide('P0');
---
<BaseLayout title="開始">
  <header class="page-header shell"><p class="eyebrow kicker">依需要閱讀</p><h1>選一個目前遇到的情境</h1><p>每條路徑包含 4–6 個小觀念，可以直接閱讀眼前需要的部分。</p></header>
  <aside class="shell start-lead callout" data-tone="leaf"><strong>還不確定要交出去什麼？</strong>先從<a href={href.guide(ideationGuide)}>盤點 Agent 能幫你做什麼</a>開始，想清楚再回來選路徑。</aside>
  <section class="shell card-grid">
    {content.paths.map((path) => <a class="card" href={href.path(path)}><span class="eyebrow kicker">{path.lessons.length} 個概念</span><h2>{path.title}</h2><p>{path.description}</p></a>)}
  </section>
</BaseLayout>
<style>
  .start-lead { margin-block: 0 2.5rem; }
  .start-lead a { font-weight: var(--weight-strong); }
</style>
