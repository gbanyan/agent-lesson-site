---
import type { Visual } from '../../lib/schemas';
type Props = Omit<Extract<Visual, { type: 'file-explorer' }>, 'type'>;
const { root, entries, summary } = Astro.props;
// Line icons (lucide folder / file), 16px, 1.5 stroke, drawn in the muted text colour.
const paths = {
  folder: ['M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z'],
  file: ['M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z', 'M14 2v4a2 2 0 0 0 2 2h4'],
};
---
<figure class="visual">
  <figcaption class="visual-label">檔案結構示意</figcaption>
  <div class="tree" aria-hidden="true" data-pagefind-ignore>
    <div class="tree-entry tree-root"><svg class="tree-icon" viewBox="0 0 24 24">{paths.folder.map((d) => <path d={d} />)}</svg>{root}</div>
    {entries.map((entry, index) => (
      <div class:list={['tree-entry', { nested: entry.depth === 1 }]}>
        <span class="tree-branch">{index === entries.length - 1 ? '└──' : '├──'}</span>
        <svg class="tree-icon" viewBox="0 0 24 24">{paths[entry.kind].map((d) => <path d={d} />)}</svg>{entry.name}
      </div>
    ))}
  </div>
  <p class="visually-equivalent sr-only">{summary}</p>
</figure>
