---
import type { Visual } from '../../lib/schemas';
type Props = Omit<Extract<Visual, { type: 'file-explorer' }>, 'type'>;
const { root, entries, summary } = Astro.props;
---
<figure class="visual">
  <figcaption class="visual-label">檔案結構示意</figcaption>
  <div class="tree" aria-hidden="true" data-pagefind-ignore>
    <div>📁 {root}</div>
    {entries.map((entry, index) => <div class:list={['tree-entry', { nested: entry.depth === 1 }]}>　{index === entries.length - 1 ? '└──' : '├──'} {entry.kind === 'folder' ? '📁' : '📄'} {entry.name}</div>)}
  </div>
  <p class="visually-equivalent sr-only">{summary}</p>
</figure>
