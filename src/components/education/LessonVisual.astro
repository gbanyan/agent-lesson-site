---
import ConceptDiagram from './ConceptDiagram.astro';
import TerminalExample from './TerminalExample.astro';
import AgentAction from './AgentAction.astro';
import FileExplorer from './FileExplorer.astro';
import PermissionPrompt from './PermissionPrompt.astro';

interface Props { lessonId: string; type: string; preset: string; }
const { lessonId, type } = Astro.props;

const concepts: Record<string, {label:string;items:{title:string;detail:string}[];relation?:string;summary:string}> = {
  A1: { label:'回答與行動', items:[{title:'聊天 AI',detail:'主要提供回答'},{title:'Coding Agent',detail:'也能使用工具行動'}], summary:'聊天 AI 主要提供回答；Coding Agent 還可以透過工具採取可觀察的行動。' },
  A2: { label:'行動邊界', items:[{title:'工具',detail:'能用什麼'},{title:'工作範圍',detail:'能碰哪裡'},{title:'權限',detail:'能做到多少'}], relation:'＋', summary:'Agent 的行動由可用工具、目前工作範圍與被授予的權限共同限制。' },
  B3: { label:'程式', items:[{title:'輸入',detail:'收到資料或要求'},{title:'程式',detail:'依規則處理'},{title:'輸出',detail:'產生結果'}], summary:'程式收到輸入，依預先寫好的規則處理，再產生輸出。' },
  B4: { label:'基本運作', items:[{title:'Input',detail:'輸入'},{title:'Process',detail:'處理'},{title:'Output',detail:'輸出'}], summary:'電腦工作可以先簡化成輸入、處理、輸出三個階段。' },
  B5: { label:'安裝不等於執行', items:[{title:'安裝',detail:'把需要的內容準備好'},{title:'執行',detail:'讓程式開始工作'}], relation:'≠', summary:'安裝是把程式準備在環境裡；執行才是讓它開始工作。' },
  B6: { label:'兩種影響', items:[{title:'讀取',detail:'取得資訊'},{title:'修改',detail:'改變狀態'}], relation:'≠', summary:'讀取只取得資訊；修改會讓檔案或系統狀態發生變化。' },
  B9: { label:'目前範圍', items:[{title:'整台電腦',detail:'不是預設想像'},{title:'目前專案',detail:'常見工作範圍'}], relation:'≠', summary:'Agent 通常從一個目前資料夾或專案工作，不代表它抽象地位於整台電腦各處。' },
  C1: { label:'位置', items:[{title:'Local',detail:'你的裝置這一端'},{title:'Remote',detail:'透過網路接觸的另一端'}], relation:'≠', summary:'Local 是你正在使用的裝置這一端；Remote 是需要透過網路接觸的另一個位置。' },
  C2: { label:'資料位置', items:[{title:'本機檔案',detail:'存在你的裝置'},{title:'遠端資料',detail:'存在另一端系統'}], relation:'或', summary:'資料可能在本機，也可能在遠端；畫面上看得到不代表資料一定存在本機。' },
  C3: { label:'執行位置', items:[{title:'資料位置',detail:'東西放在哪裡'},{title:'執行位置',detail:'工作在哪裡發生'}], relation:'≠', summary:'資料存放位置和程式執行位置是兩個不同問題。' },
  C4: { label:'三個不同問題', items:[{title:'資料',detail:'放在哪裡'},{title:'程式',detail:'在哪裡執行'},{title:'模型',detail:'在哪裡推理'}], relation:'≠', summary:'資料位置、程式執行位置與 AI 模型推理位置彼此不同，必須分開確認。' },
  C5: { label:'資料移動', items:[{title:'你的電腦',detail:'資料起點'},{title:'網路連線',detail:'交換通道'},{title:'外部系統',detail:'資料到達處'}], summary:'當工具透過網路把內容傳給外部服務時，資料就離開本機。' },
  C6: { label:'三種資源', items:[{title:'CPU',detail:'做運算'},{title:'記憶體',detail:'暫時放工作中的內容'},{title:'儲存空間',detail:'較長期保存資料'}], relation:'／', summary:'CPU 負責運算、記憶體暫存工作中內容、儲存空間較長期保存資料。' },
  C7: { label:'發布狀態', items:[{title:'本機修改',detail:'只有本機狀態改變'},{title:'發布',detail:'讓其他人取得新版'}], relation:'≠', summary:'在本機改好不等於已發布；其他人通常要等變更被送到他們能存取的位置。' },
  D1: { label:'目前資訊', items:[{title:'已取得資訊',detail:'能用來工作'},{title:'未提供資訊',detail:'不能假定知道'}], relation:'≠', summary:'Agent 只能根據目前取得的資訊工作，也不應假定它永遠保有以前的內容。' },
  D2: { label:'採取行動', items:[{title:'Agent',detail:'決定下一個可觀察步驟'},{title:'Tool',detail:'執行實際操作'},{title:'結果',detail:'回到 Agent'}], summary:'Tool 是 Agent 用來讀取資訊、修改內容或連接外部系統的行動方式之一。' },
  D5: { label:'影響範圍', items:[{title:'一般權限',detail:'較有限的範圍'},{title:'管理員權限',detail:'可能影響更多系統區域'}], summary:'管理員權限可能讓同一個動作影響更大的系統範圍。' },
  D6: { label:'限制機制', items:[{title:'Sandbox 內',detail:'允許的行動範圍'},{title:'Sandbox 外',detail:'受到限制或需另行允許'}], relation:'｜', summary:'Sandbox 用邊界限制可採取的行動，但它不是絕對安全的保證。' },
  E1: { label:'能否復原', items:[{title:'修改',detail:'狀態已改變'},{title:'恢復來源',detail:'不一定存在'}], relation:'需要確認', summary:'修改發生後，是否能復原取決於是否有可用的舊狀態或獨立副本。' },
  E2: { label:'獨立副本', items:[{title:'原始資料',detail:'平常使用'},{title:'Backup',detail:'另一份可恢復副本'}], relation:'＋', summary:'Backup 是原始資料之外，另有一份可以在出事後用來恢復的副本。' },
  E3: { label:'目標不同', items:[{title:'Sync',detail:'讓各處保持一致'},{title:'Backup',detail:'出事後回復資料'}], relation:'≠', summary:'Sync 的主要目標是保持一致；Backup 的主要目標是出事後恢復。同步也可能把錯誤一起傳過去。' },
  E4: { label:'較早狀態', items:[{title:'現在',detail:'目前內容'},{title:'Version history',detail:'可查看較早狀態'}], relation:'回看', summary:'Version history 保留較早的狀態，讓你能查看或在支援時恢復。' },
  E5: { label:'角色界線', items:[{title:'Git',detail:'記錄專案變化'},{title:'Backup',detail:'獨立恢復副本'}], relation:'≠', summary:'Git 是版本管理工具，能記錄專案變化；它本身不等於完整備份。' },
  E6: { label:'重大修改前', items:[{title:'目前可用狀態',detail:'先確認'},{title:'可恢復點',detail:'先建立或找到'},{title:'重大修改',detail:'再開始'}], summary:'先知道可以從哪裡回去，再讓重大修改開始。' },
  E7: { label:'可能的影響', items:[{title:'檔案與資料庫',detail:'本機或資料狀態'},{title:'遠端與已發布系統',detail:'別人可能看得到'},{title:'外部服務',detail:'可能有費用或副作用'}], relation:'／', summary:'Agent 的行動可能影響檔案、資料庫、遠端或已發布系統，以及外部服務。' },
  F1: { label:'檢視變更', items:[{title:'修改前',detail:'原本狀態'},{title:'差異',detail:'哪些地方改了'},{title:'修改後',detail:'目前狀態'}], summary:'檢視修改前後的差異，才能知道 Agent 實際改了什麼。' },
  F2: { label:'完成判斷', items:[{title:'Agent 的說法',detail:'完成聲明'},{title:'檢查結果',detail:'可觀察證據'}], relation:'≠', summary:'Agent 說完成是一項聲明；通過與目標相符的檢查，才是驗證。' },
  F3: { label:'秘密資訊', items:[{title:'密碼或 API Key',detail:'能代表你取得存取權'},{title:'一般文字',detail:'通常不具同等權限'}], relation:'≠', summary:'密碼與 API Key 可能讓持有者以你的身分存取系統，因此需要避免不必要的暴露。' },
  F4: { label:'上網的雙向意義', items:[{title:'取得內容',detail:'從網路讀取'},{title:'送出內容',detail:'與外部系統交換資料'}], relation:'＋', summary:'能上網不只代表能搜尋，也可能代表能把資料送往外部；網路內容也不會因被讀到就自動可信。' },
};
---
{type === 'terminal' ? (
  <TerminalExample purpose="查看目前的位置" command="pwd" output="/Users/you/project" impact="read" summary="先看動作的目的與影響，再看指令文字。這個例子只讀取目前位置。" />
) : type === 'agent-action' ? (
  <AgentAction request="看看這個資料夾裡有什麼。" intent="查看資料夾內容" tool="Terminal：ls" result="找到 website、photos、notes.txt" next="根據結果決定是否還需要下一步" />
) : type === 'file-explorer' ? (
  <FileExplorer />
) : type === 'permission' ? (
  <PermissionPrompt />
) : concepts[lessonId] ? (
  <ConceptDiagram {...concepts[lessonId]} />
) : null}
