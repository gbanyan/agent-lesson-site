---
import ConceptDiagram from './ConceptDiagram.astro';
import TerminalExample from './TerminalExample.astro';
import AgentAction from './AgentAction.astro';
import FileExplorer from './FileExplorer.astro';
import PermissionPrompt from './PermissionPrompt.astro';
import SystemMap from './SystemMap.astro';

interface Props { lessonId: string; type: string; preset: string; }
const { lessonId, type } = Astro.props;

type SystemStep = { place:string; title:string; detail:string; tone?:'local'|'agent'|'remote'|'result' };
type SystemLane = { title:string; steps:SystemStep[] };
const systemMaps: Record<string, {label:string;lanes:SystemLane[];summary:string}> = {
  A1: { label:'聊天與行動的差別', lanes:[
    { title:'聊天 AI', steps:[{place:'你',title:'提出問題',detail:'請它說明做法'},{place:'模型',title:'產生回答',detail:'回傳文字'},{place:'你',title:'自己操作',detail:'檔案不會自動改變',tone:'result'}]},
    { title:'Agent', steps:[{place:'你',title:'交代任務',detail:'說明範圍與要求'},{place:'Agent',title:'選擇工具',detail:'依權限採取行動',tone:'agent'},{place:'檔案或服務',title:'狀態改變',detail:'留下可檢查的結果',tone:'result'}]},
  ], summary:'聊天 AI 通常回傳文字，由你自己操作。Agent 可以使用工具，讓檔案或外部服務產生變化。' },
  B9: { label:'工作範圍', lanes:[
    { title:'已開放', steps:[{place:'目前資料夾',title:'報表工作區',detail:'Agent 可以查看與修改',tone:'agent'},{place:'範圍內',title:'第一季.xlsx',detail:'這次任務會處理',tone:'result'}]},
    { title:'未開放', steps:[{place:'其他位置',title:'相簿與郵件',detail:'不在目前工作範圍'},{place:'需要時',title:'另行確認',detail:'不能自行擴大範圍',tone:'remote'}]},
  ], summary:'Agent 只應在目前開放的工作範圍內處理資料；其他位置要另外確認。' },
  C1: { label:'本機與遠端', lanes:[
    { title:'Local', steps:[{place:'你的裝置',title:'notes.md',detail:'資料留在這台電腦',tone:'local'}]},
    { title:'Remote', steps:[{place:'你的裝置',title:'上傳檔案',detail:'開始傳送',tone:'local'},{place:'網路',title:'資料移動',detail:'離開裝置'},{place:'另一端',title:'團隊空間',detail:'其他人可能看見',tone:'remote'}]},
  ], summary:'Local 是你的裝置這一端。資料經網路送到另一個系統後，就有了 Remote 副本。' },
  C2: { label:'畫面與儲存位置', lanes:[
    { title:'本機檔案', steps:[{place:'瀏覽器或應用程式',title:'畫面顯示內容',detail:'從硬碟讀取'},{place:'你的裝置',title:'企劃書.docx',detail:'實際存放位置',tone:'local'}]},
    { title:'遠端文件', steps:[{place:'瀏覽器或應用程式',title:'畫面顯示內容',detail:'看起來可能相同'},{place:'服務商系統',title:'線上企劃書',detail:'實際存放位置',tone:'remote'}]},
  ], summary:'同樣在螢幕上看到文件，資料可能存在本機，也可能只存在遠端服務。' },
  C3: { label:'工作在哪裡發生', lanes:[
    { title:'本機執行', steps:[{place:'你的裝置',title:'Agent 執行工具',detail:'使用本機 CPU',tone:'local'},{place:'你的裝置',title:'產生結果',detail:'直接讀寫本機檔案',tone:'result'}]},
    { title:'遠端執行', steps:[{place:'你的裝置',title:'送出任務',detail:'透過網路'},{place:'遠端環境',title:'執行工具',detail:'使用另一台電腦',tone:'remote'},{place:'你的裝置',title:'取回結果',detail:'可能需要下載',tone:'result'}]},
  ], summary:'同一項工作可以在你的裝置執行，也可以送到遠端環境執行；兩者使用的檔案與資源可能不同。' },
  C4: { label:'三個位置要分開看', lanes:[
    { title:'資料', steps:[{place:'你的裝置或遠端',title:'會議記錄',detail:'檔案存放的位置'}]},
    { title:'Agent', steps:[{place:'你的裝置或遠端',title:'讀檔與使用工具',detail:'工作流程執行的位置',tone:'agent'}]},
    { title:'AI 模型', steps:[{place:'你的裝置或供應商',title:'產生摘要',detail:'模型實際運算的位置',tone:'remote'}]},
  ], summary:'資料存放、Agent 執行工具與 AI 模型運算可能發生在三個不同位置。' },
  C5: { label:'資料離開裝置的路徑', lanes:[
    { title:'送出內容', steps:[{place:'你的裝置',title:'錯誤紀錄',detail:'檢查完整內容',tone:'local'},{place:'Agent 工具',title:'建立線上項目',detail:'準備傳送',tone:'agent'},{place:'網路',title:'上傳資料',detail:'資料離開裝置'},{place:'外部服務',title:'保存內容',detail:'他人可能存取',tone:'remote'}]},
  ], summary:'Agent 使用網路工具時，本機內容會經過網路送到外部服務。' },
  C7: { label:'本機修改與公開版本', lanes:[
    { title:'尚未發布', steps:[{place:'你的裝置',title:'修改活動公告',detail:'只有本機副本改變',tone:'local'},{place:'公開位置',title:'仍是舊版本',detail:'其他人看不到新內容',tone:'remote'}]},
    { title:'完成發布', steps:[{place:'你的裝置',title:'送出新版',detail:'啟動發布或同步',tone:'local'},{place:'公開位置',title:'取得新版',detail:'其他人現在看得到',tone:'result'}]},
  ], summary:'本機改好之後，還要把新版送到公開或共享位置，其他人才會看到變更。' },
  D2: { label:'Agent 如何使用工具', lanes:[
    { title:'一次動作', steps:[{place:'Agent',title:'決定下一步',detail:'根據你的要求',tone:'agent'},{place:'工具',title:'執行操作',detail:'讀檔、改檔或連線'},{place:'結果',title:'回到 Agent',detail:'用來判斷下一步',tone:'result'}]},
  ], summary:'Agent 選擇工具執行操作，工具結果再回到 Agent，供它決定下一步。' },
  D3: { label:'檢查、行動、再檢查', lanes:[
    { title:'合併文件', steps:[{place:'兩份來源',title:'讀取修訂版',detail:'找出文字與註解差異',tone:'local'},{place:'Agent',title:'整理衝突',detail:'不確定時停下詢問',tone:'agent'},{place:'新檔案',title:'合併結果',detail:'不覆蓋兩份來源',tone:'result'},{place:'再次檢查',title:'核對章節',detail:'確認沒有漏掉內容'}]},
  ], summary:'Agent 比較兩份文件，處理能確定的差異；完成新檔後還要重新檢查。' },
  E7: { label:'動作可能落在哪裡', lanes:[
    { title:'你的裝置', steps:[{place:'本機',title:'檔案或資料庫',detail:'內容可能改變',tone:'local'}]},
    { title:'外部世界', steps:[{place:'共享服務',title:'行事曆或文件',detail:'同事可能立刻看見',tone:'remote'},{place:'其他系統',title:'通知或帳單',detail:'可能產生後續影響',tone:'remote'}]},
  ], summary:'Agent 的動作可能留在本機，也可能改變共享文件、通知、帳單等外部狀態。' },
  F4: { label:'網路是雙向的', lanes:[
    { title:'取得資料', steps:[{place:'外部網站',title:'目前公告',detail:'來源可能可靠或有誤',tone:'remote'},{place:'網路',title:'下載內容',detail:'送進 Agent'},{place:'Agent',title:'讀取與判斷',detail:'不能自動當成指令',tone:'agent'}]},
    { title:'送出資料', steps:[{place:'你的裝置',title:'檔案或問題',detail:'檢查送出內容',tone:'local'},{place:'網路',title:'上傳內容',detail:'離開裝置'},{place:'外部服務',title:'接收資料',detail:'依服務規則處理',tone:'remote'}]},
  ], summary:'網路工具可以把資料帶進來，也可以把本機內容送出去；兩個方向都要檢查。' },
};

const concepts: Record<string, {label:string;items:{title:string;detail:string}[];relation?:string;summary:string}> = {
  A2: { label:'行動邊界', items:[{title:'工具',detail:'能用什麼'},{title:'工作範圍',detail:'能碰哪裡'},{title:'權限',detail:'能做到多少'}], relation:'＋', summary:'Agent 的行動由可用工具、目前工作範圍與被授予的權限共同限制。' },
  B3: { label:'程式', items:[{title:'輸入',detail:'收到資料或要求'},{title:'程式',detail:'依規則處理'},{title:'輸出',detail:'產生結果'}], summary:'程式收到輸入，依預先寫好的規則處理，再產生輸出。' },
  B4: { label:'基本運作', items:[{title:'Input',detail:'輸入'},{title:'Process',detail:'處理'},{title:'Output',detail:'輸出'}], summary:'電腦工作可以簡化成輸入、處理、輸出三個階段。' },
  B5: { label:'安裝不等於執行', items:[{title:'安裝',detail:'把需要的內容準備好'},{title:'執行',detail:'讓程式開始工作'}], relation:'≠', summary:'安裝是把程式準備在環境裡；執行才是讓它開始工作。' },
  B6: { label:'兩種影響', items:[{title:'讀取',detail:'取得資訊'},{title:'修改',detail:'改變狀態'}], relation:'≠', summary:'讀取只取得資訊；修改會讓檔案或系統狀態發生變化。' },
  C6: { label:'三種資源', items:[{title:'CPU',detail:'做運算'},{title:'記憶體',detail:'暫時放工作中的內容'},{title:'儲存空間',detail:'較長期保存資料'}], relation:'／', summary:'CPU 負責運算、記憶體暫存工作中內容、儲存空間較長期保存資料。' },
  D1: { label:'工作記憶', items:[{title:'眼前資訊',detail:'能拿來工作'},{title:'沒有提供',detail:'不一定知道'}], relation:'≠', summary:'Agent 只能根據眼前的工作記憶做事，不一定還記得之前看過的內容。' },
  D5: { label:'影響範圍', items:[{title:'一般權限',detail:'較有限的範圍'},{title:'管理員權限',detail:'可能影響更多系統區域'}], summary:'管理員權限可能讓同一個動作影響更大的系統範圍。' },
  D6: { label:'限制機制', items:[{title:'Sandbox 內',detail:'允許的行動範圍'},{title:'Sandbox 外',detail:'受到限制或需另行允許'}], relation:'｜', summary:'Sandbox 用邊界限制可採取的行動，但它不是絕對安全的保證。' },
  E1: { label:'能否復原', items:[{title:'修改',detail:'狀態已改變'},{title:'恢復來源',detail:'不一定存在'}], relation:'需要確認', summary:'修改發生後，是否能復原取決於是否有可用的舊狀態或獨立副本。' },
  E2: { label:'獨立副本', items:[{title:'原始資料',detail:'平常使用'},{title:'Backup',detail:'另一份可恢復副本'}], relation:'＋', summary:'Backup 是原始資料之外，另有一份可以在出事後用來恢復的副本。' },
  E3: { label:'目標不同', items:[{title:'Sync',detail:'讓各處保持一致'},{title:'Backup',detail:'出事後回復資料'}], relation:'≠', summary:'Sync 的主要目標是保持一致；Backup 的主要目標是出事後恢復。同步也可能把錯誤一起傳過去。' },
  E4: { label:'較早狀態', items:[{title:'現在',detail:'目前內容'},{title:'版本歷史',detail:'可查看較早狀態'}], relation:'回看', summary:'版本歷史保留過去的存檔；服務有提供恢復功能時，也能用它找回舊內容。' },
  E5: { label:'角色界線', items:[{title:'Git',detail:'記錄專案變化'},{title:'Backup',detail:'獨立恢復副本'}], relation:'≠', summary:'Git 能記錄專案變化；完整備份仍要另外保留。' },
  E6: { label:'重大修改前', items:[{title:'目前可用狀態',detail:'確認可正常運作'},{title:'可恢復點',detail:'建立或找到'},{title:'重大修改',detail:'開始執行'}], summary:'重大修改應在確認可恢復狀態後開始。' },
  F1: { label:'檢視變更', items:[{title:'修改前',detail:'原本狀態'},{title:'差異',detail:'哪些地方改了'},{title:'修改後',detail:'目前狀態'}], summary:'檢視修改前後的差異，才能知道 Agent 實際改了什麼。' },
  F2: { label:'完成判斷', items:[{title:'Agent 的說法',detail:'口頭回報'},{title:'檢查結果',detail:'實際證據'}], relation:'≠', summary:'Agent 說完成只是口頭回報；看到符合要求的檢查結果，才算驗證。' },
  F3: { label:'秘密資訊', items:[{title:'密碼或 API Key',detail:'能代表你取得存取權'},{title:'一般文字',detail:'通常不具同等權限'}], relation:'≠', summary:'密碼與 API Key 可能讓持有者以你的身分存取系統，因此需要避免不必要的暴露。' },
};
---
{systemMaps[lessonId] ? (
  <SystemMap {...systemMaps[lessonId]} />
) : type === 'terminal' ? (
  lessonId === 'B8'
    ? <TerminalExample purpose="列出報表資料夾的檔案" command="ls 報表" output="一月.xlsx　二月.xlsx　摘要.docx" impact="read" summary="這行指令讀取資料夾目錄並列出檔名，不會修改檔案內容。" />
    : <TerminalExample purpose="查看目前的位置" command="pwd" output="/Users/you/工作" impact="read" summary="這行指令只讀取目前位置。指令的目的與影響是判斷重點。" />
) : type === 'agent-action' ? (
  <AgentAction request="看看這個資料夾裡有什麼。" intent="查看資料夾內容" tool="終端機：ls" result="找到 報表、照片、notes.txt" next="根據結果決定是否還需要下一步" />
) : type === 'file-explorer' ? (
  <FileExplorer root="家庭支出" summary="家庭支出資料夾裡有 2025、2026 兩個資料夾，以及一份 notes.txt。" />
) : type === 'permission' ? (
  <PermissionPrompt files={['Downloads/收據-01.jpg', '差旅報帳/收據-01.jpg']} consequence="允許後，Agent 會讀取下載的圖片，並在差旅報帳資料夾建立副本。" />
) : concepts[lessonId] ? (
  <ConceptDiagram {...concepts[lessonId]} />
) : null}
