---
import type { Visual } from '../../lib/schemas';
import ConceptDiagram from './ConceptDiagram.astro';
import FileExplorer from './FileExplorer.astro';
import PermissionPrompt from './PermissionPrompt.astro';
import SystemMap from './SystemMap.astro';
import TerminalExample from './TerminalExample.astro';

// Renders a lesson's `visual` frontmatter; all diagram data lives in the lesson file.
interface Props { visual: Visual; }
const { visual } = Astro.props;
---
<div class="wide lesson-visual">
  {visual.type === 'system-map' ? <SystemMap {...visual} />
    : visual.type === 'concept' ? <ConceptDiagram {...visual} />
    : visual.type === 'terminal' ? <TerminalExample {...visual} />
    : visual.type === 'file-explorer' ? <FileExplorer {...visual} />
    : <PermissionPrompt {...visual} />}
  {visual.type === 'system-map' && visual.more && (
    <details><summary>{visual.more.label}</summary><SystemMap {...visual.more.map} /></details>
  )}
</div>
