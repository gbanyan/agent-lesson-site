---
import type { Prompt } from '../../lib/schemas';
import { uid } from '../../lib/uid';
import CopyablePrompt from './CopyablePrompt.astro';

interface Props { prompt: Prompt; }
const { prompt } = Astro.props;
const kind = prompt.audience === 'research_chat' ? 'research' : prompt.mode === 'execute_after_confirmation' ? 'task' : 'agent';
const copy = {
  research: { title: '問能查官方資料的 AI', action: '複製查詢', tone: 'blue', description: '適合查價格、方案、安裝方式、產品支援與官方文件。它不一定能檢查你目前電腦裡的實際狀態。' },
  task: { title: '加入任務要求', action: '複製任務限制', tone: 'amber', description: '送出後，Agent 可能依內容開始檢查或修改。確認工作範圍後再使用。' },
  agent: { title: '問目前正在工作的 Agent', action: '複製問題', tone: undefined, description: '適合詢問已開啟目前工作資料夾的 Agent。它可以根據眼前的檔案與權限回答。' },
}[kind];
const capability = {
  requires_web: '需要網路查詢',
  requires_workspace_access: '需要讀取目前工作資料夾',
  no_special_access: '不需特殊存取',
}[prompt.capability];
const titleId = uid('follow-up-', `${Astro.url.pathname}|${prompt.text}`);
---
<aside class:list={['follow-up', 'panel', `prompt-${kind}`]} data-tone={copy.tone} aria-labelledby={titleId}>
  <CopyablePrompt text={prompt.text} buttonLabel={copy.action}>
    <p slot="before" class="prompt-audience note">{capability}</p>
    <h2 slot="heading" id={titleId}>{copy.title}</h2>
    <p class="muted">{copy.description}</p>
  </CopyablePrompt>
</aside>
