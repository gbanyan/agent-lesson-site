---
interface Props { files?: string[]; consequence?: string; }
const { files = ['index.html', 'styles.css', 'about.html'], consequence = '允許後，Agent 會直接改寫這些檔案。' } = Astro.props;
---
<figure class="visual">
  <figcaption class="visual-label">權限要求示意（不是特定產品畫面）</figcaption>
  <div class="permission-box" aria-hidden="true">
    <h3>Agent 要求權限</h3>
    <p>Agent 想修改：</p>
    <div class="permission-files">{files.join('、')}</div>
    <p>{consequence}</p>
    <div class="permission-actions" aria-label="示意選項">
      <span class="mock-button">取消</span><span class="mock-button primary">允許</span>
    </div>
  </div>
  <p class="visually-equivalent">權限提示列出 Agent 想修改的 {files.join('、')}。{consequence}使用者可以允許或取消。</p>
</figure>
