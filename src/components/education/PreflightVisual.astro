---
import SystemMap from './SystemMap.astro';

interface Props { guideId: string; }
const { guideId } = Astro.props;
type Step = { place:string; title:string; detail:string; tone?:'local'|'agent'|'remote'|'result' };
type Lane = { title:string; steps:Step[] };
const maps: Record<string, {label:string;lanes:Lane[];summary:string}> = {
  P0: { label:'電腦早就會的事，加上你的判斷', lanes:[
    { title:'已經做得到', steps:[{place:'你的程式',title:'彙總、比對、批次改',detail:'每個動作都有人先實作過',tone:'local'},{place:'現成做法',title:'報表、對帳、檢查表',detail:'你領域裡的固定套路',tone:'agent'}]},
    { title:'過去要人判斷', steps:[{place:'你的標準',title:'哪幾張算選好的',detail:'模糊的取捨只能你自己來',tone:'remote'},{place:'Agent 接上',title:'依描述決定步驟',detail:'會做也可能錯，做完要檢查',tone:'result'}]},
  ], summary:'Agent 用的手都是電腦早就會的事；新增的是它聽你描述去決定順序，這一步會錯，所以要檢查。' },
  P1: { label:'兩張帳單可能分開計算', lanes:[
    { title:'App', steps:[{place:'你的帳號',title:'固定訂閱',detail:'可能含每月額度',tone:'agent'},{place:'超過限制',title:'停用或另計',detail:'依目前方案規則',tone:'result'}]},
    { title:'API', steps:[{place:'開發者帳戶',title:'用量計費',detail:'依輸入、輸出或工具使用',tone:'remote'},{place:'帳單',title:'另外結算',detail:'不一定包含在 App 訂閱',tone:'result'}]},
  ], summary:'同一家公司的 App 訂閱與 API 用量可能分開計費，需要各自查看帳單與限制。' },
  P2: { label:'介面相同，位置與能力未必相同', lanes:[
    { title:'桌面版', steps:[{place:'你的裝置',title:'應用程式視窗',detail:'用按鈕選資料夾',tone:'local'},{place:'權限提示',title:'開放檔案或網路',detail:'依系統與產品設定',tone:'agent'}]},
    { title:'CLI', steps:[{place:'終端機',title:'輸入文字指令',detail:'從目前資料夾開始',tone:'local'},{place:'工具所在位置',title:'使用工具',detail:'可用範圍要另外確認',tone:'agent'}]},
    { title:'網頁版', steps:[{place:'瀏覽器',title:'開啟服務',detail:'本機只顯示介面'},{place:'遠端系統',title:'保存或處理資料',detail:'依服務規則',tone:'remote'}]},
  ], summary:'桌面版、CLI 與網頁版可能登入同一帳號，但工作位置、工具與權限不一定相同。' },
  P3: { label:'公司、模型與 Agent 是三個層次', lanes:[
    { title:'供應商', steps:[{place:'公司',title:'提供模型與服務',detail:'決定方案和資料規則',tone:'remote'}]},
    { title:'模型', steps:[{place:'AI 模型',title:'處理輸入',detail:'能力會隨版本改變',tone:'agent'}]},
    { title:'Agent 產品', steps:[{place:'你使用的介面',title:'組合模型與工具',detail:'實際體驗還受權限影響',tone:'result'}]},
  ], summary:'供應商、AI 模型與 Agent 產品是三個不同層次；評估時要分開看。' },
  P4: { label:'你送出的內容，離開裝置的路徑', lanes:[
    { title:'模型處理', steps:[{place:'你的裝置',title:'對話與檔案',detail:'可能還包含工具結果',tone:'local'},{place:'網路',title:'上傳內容',detail:'資料離開裝置'},{place:'模型供應商',title:'處理與保存',detail:'依帳號和服務規則',tone:'remote'}]},
    { title:'其他工具', steps:[{place:'Agent',title:'搜尋或外掛',detail:'啟動其他服務',tone:'agent'},{place:'外部系統',title:'收到部分內容',detail:'可能有不同資料規則',tone:'remote'}]},
  ], summary:'送出的內容可能經模型供應商處理，也可能因搜尋、外掛或其他工具流向不同服務。' },
  P5: { label:'跟著產品變的，與跟著工作不變的', lanes:[
    { title:'會換的部分', steps:[{place:'產品名稱與介面',title:'按鈕與版面',detail:'會隨版本或公司變動',tone:'agent'},{place:'方案與排行',title:'價格、額度、排行榜',detail:'查目前官方即可'},{place:'安裝與帳號',title:'位置與權限方式',detail:'每套可能不同',tone:'remote'}]},
    { title:'不變的部分', steps:[{place:'你的資料',title:'在哪裡、它拿了哪些',detail:'換產品仍是同一組問題',tone:'local'},{place:'你的決定',title:'准了什麼、怎麼檢查',detail:'結果要核對，不只看描述',tone:'result'},{place:'你的後路',title:'改壞了怎麼救',detail:'先保留舊版或副本',tone:'result'}]},
  ], summary:'產品名稱、介面、方案與排行榜會變；資料位置、授權、結果檢查與復原，換了產品仍是同一組問題。' },
  P6: { label:'把 AI 當成陌生領域的嚮導', lanes:[
    { title:'先畫輪廓', steps:[{place:'你',title:'說清楚程度與困惑',detail:'先別假設它懂你',tone:'local'},{place:'AI',title:'給整體輪廓與名詞',detail:'也講常見誤解',tone:'agent'}]},
    { title:'逐層深挖', steps:[{place:'你',title:'挑一兩點往下問',detail:'結合你的工作或興趣',tone:'local'},{place:'AI',title:'用類比或小例子',detail:'並指出你可能誤解',tone:'agent'}]},
    { title:'核對再相信', steps:[{place:'AI',title:'標出處與不確定處',detail:'區分共識與爭論',tone:'remote'},{place:'你',title:'判斷來源與一致性',detail:'不一致就追問',tone:'result'}]},
  ], summary:'陌生領域先請 AI 幫你畫出輪廓，再逐層往深處問；它給的內容要看來源與前後是否一致，不能照單全收。' },
  P7: { label:'把一件事交給 Agent 的審核循環', lanes:[
    { title:'先講清楚', steps:[{place:'你',title:'目標與範圍',detail:'哪些動、哪些不動',tone:'local'},{place:'Agent',title:'重述並指出缺的資訊',detail:'先別急著動手',tone:'agent'}]},
    { title:'檢視再放行', steps:[{place:'Agent',title:'提出草案',detail:'要改哪些檔案、動哪個範圍',tone:'agent'},{place:'你',title:'檢視影響',detail:'範圍不符就退回',tone:'result'}]},
    { title:'完成後檢查', steps:[{place:'Agent',title:'動手完成',detail:'依准許的範圍',tone:'agent'},{place:'你',title:'檢查實際結果',detail:'不只看「完成」',tone:'result'},{place:'回退',title:'從保留的版本重來',detail:'動手前已備好'}]},
  ], summary:'交出去分成幾步：先講清目標與範圍，讓它先提出要動什麼，你檢視並批准後才動手；完成後檢查實際結果，不合用就從保留的版本回退。' },
};
const map = maps[guideId];
---
{map && <SystemMap {...map} />}
