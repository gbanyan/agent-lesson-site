---
import { uid } from '../../lib/uid';
interface Props { url: string; items: string[]; }
const { url, items } = Astro.props;
const titleId = uid('official-', `${Astro.url.pathname}|${url}`);
---
<aside class="official-notice" aria-labelledby={titleId}>
  <h2 id={titleId}>最新功能與方案以官方為準</h2>
  <p>AI 工具更新很快，收費方式與功能限制也會調整。使用前請查閱：</p>
  <ul>{items.map((item) => <li>{item}</li>)}</ul>
  <a href={url}>查看官方資訊 <span aria-hidden="true">→</span></a>
</aside>
