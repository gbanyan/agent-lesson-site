---
import type { GuidePrompt } from '../../lib/schemas';
import { uid } from '../../lib/uid';
import CopyablePrompt from './CopyablePrompt.astro';

interface Props { prompts: GuidePrompt[]; }
const { prompts } = Astro.props;
const titleId = uid('prompt-shelf-', `${Astro.url.pathname}|${prompts.map((prompt) => prompt.label).join('|')}`);
const needsWeb = prompts.some((prompt) => prompt.capability === 'requires_web');
---
<section class="prompt-shelf" aria-labelledby={titleId}>
  <p class="eyebrow kicker">{needsWeb ? '查詢目前資訊' : '先想，再查'}</p>
  <h2 id={titleId}>{needsWeb ? '問能查官方資料的 AI' : '問你手邊的 AI 就好'}</h2>
  <p>{needsWeb ? '這些查詢適合能瀏覽官方網頁或公開資訊的 AI。它不一定能看到你目前電腦裡的檔案、設定或權限。' : '這些問題不需要網路，把你的狀況描述給它就夠。貼上內容以前，先移除密碼、金鑰、個資與公司機密。'}</p>
  <div class="prompt-list">
    {prompts.map((prompt) => (
      <article class="prompt-card panel">
        <CopyablePrompt text={prompt.text} buttonLabel="複製查詢" ariaLabel={`複製「${prompt.label}」查詢`}>
          <h3 slot="heading">{prompt.label}</h3>
          <p slot="after" class="prompt-capability note">{prompt.capability === 'requires_web' ? '需要網路查詢' : '不需特殊存取'}</p>
        </CopyablePrompt>
      </article>
    ))}
  </div>
</section>

<style>
  .prompt-shelf { margin-block: 4rem 2rem; padding-top: 2.5rem; border-top: 1px solid var(--line); }
  .prompt-shelf > h2 { margin-top: .25rem; }
  .prompt-list { display: grid; gap: 1rem; margin-top: 1.5rem; }
  .prompt-capability { margin: .75rem 0 0; }
</style>
