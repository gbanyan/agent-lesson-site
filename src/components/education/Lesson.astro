---
import Takeaway from './Takeaway.astro';
import FollowUpQuestion from './FollowUpQuestion.astro';
interface Props {
  id: string; question: string; answer: string; takeaway: string; newTerms: string[];
  followUp?: string | undefined;
  searchTerms?: string[] | undefined;
  scenario: { request: string; actions: string[]; result: string; boundary: string };
  next?: { href: string; label: string } | undefined; previous?: { href: string; label: string } | undefined;
}
const { id, question, answer, takeaway, followUp, newTerms, searchTerms = [], scenario, next, previous } = Astro.props;
---
<article class="lesson reading" data-pagefind-body>
  <header>
    {searchTerms.length > 0 && <span class="search-alias" aria-hidden="true" data-pagefind-weight="0.5">{searchTerms.join(' ')}</span>}
    <div class="lesson-meta"><span>微課程 {id}</span><span aria-hidden="true">·</span><span>約 1 分鐘</span></div>
    <h1 data-pagefind-meta="title">{question}</h1>
    <p class="lesson-answer">{answer}</p>
  </header>
  <slot name="visual" />
  <div class="lesson-body"><slot /></div>
  <section class="scenario" aria-labelledby={`scenario-${id}`}>
    <p class="scenario-kicker">放進真實情境</p>
    <h2 id={`scenario-${id}`}>如果你這樣跟 Agent 說</h2>
    <blockquote>{scenario.request}</blockquote>
    <h3>接下來可能會發生</h3>
    <ol>{scenario.actions.map((action) => <li>{action}</li>)}</ol>
    <p><strong>你會看到的結果：</strong>{scenario.result}</p>
    <aside class="scenario-boundary"><strong>這個例子的邊界：</strong>{scenario.boundary}</aside>
  </section>
  {newTerms.length > 0 && <ul class="term-list" aria-label="這頁的新名詞">{newTerms.map((term) => <li>{term}</li>)}</ul>}
  <Takeaway text={takeaway} />
  {followUp && <FollowUpQuestion text={followUp} />}
  <nav class="lesson-next" aria-label="課程前後導覽">
    <span>{previous && <a href={previous.href}>← {previous.label}</a>}</span>
    <span>{next && <a href={next.href}>{next.label} →</a>}</span>
  </nav>
</article>
