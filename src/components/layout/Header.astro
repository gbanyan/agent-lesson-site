---
import { url } from '../../lib/urls';
const path = Astro.url.pathname;
const current = (segment: string) => path.includes(`/${segment}`) ? 'page' : undefined;
---
<header class="site-header">
  <div class="shell nav">
    <a class="brand" href={url('/')}>看懂 Agent</a>
    <nav class="nav-links" aria-label="主要導覽">
      <a href={url('/prepare/')} aria-current={current('prepare')}>開始</a>
      <a href={url('/concepts/')} aria-current={current('concepts')}>找概念</a>
      <a href={url('/about/')} aria-current={current('about')}>關於本站</a>
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="切換網站外觀">
      <span aria-hidden="true" class="theme-icon"></span>
      <span data-theme-label>外觀：跟隨系統</span>
    </button>
  </div>
</header>
